{
  "sender": "granite-3.3-8b-instruct",
  "receiver": "HuggingFaceTB/SmolLM3-3B",

  "traces": {
    "raw": "{run}/traces/gsm8k_train.jsonl",
    "clean": "{run}/traces/gsm8k_train_clean.jsonl",
    "min_raw_rows": 7400,
    "min_clean_rows": 6500,
    "gpus": 1,
    "generate_args": {
      "receiver-model": "{receiver}",
      "tasks": ["gsm8k:train"],
      "batch-size": 32,
      "max-new-tokens": 512,
      "max-length": 2048,
      "device": "cuda:0"
    }
  },

  "train_common": {
    "args": {
      "sender-model": "{sender}",
      "receiver-model": "{receiver}",
      "exclude-answer-message": true,
      "arch": "v2",
      "d-model": 1024,
      "n-layers": 9,
      "n-heads": 16,
      "ffn-dim": 4096,
      "causal-cross-attention": true,
      "bound-cache-stats": true,
      "bound-stats-exact-grad": true,
      "max-length": 8192,
      "seed": 44,
      "device": "cuda:0",
      "receiver-device": "cuda:1",
      "renderer-device": "cuda:0"
    }
  },

  "stage1": {
    "gpus": 2,
    "args": {
      "output-dir": "{run}/stage1",
      "datasets": ["{repo}/multiagent/data/renderer_text/pg19_wikitext103_train_4k4k_20m.jsonl", "qasper+nox:train", "quality:train", "hotpotqa:train", "musique:train"],
      "limit-per-dataset": 2500,
      "max-trace-length": 4096,
      "batch-size": 1,
      "epochs": 1,
      "max-steps": 5000,
      "learning-rate": 3e-4,
      "lr-scheduler": "cosine",
      "warmup-steps": 300,
      "weight-decay": 0.001,
      "max-grad-norm": 1.0,
      "grad-skip-threshold": 5.0,
      "stat-calibration-batches": 8,
      "phase-schedule": "kv-only",
      "position-mode": "interp",
      "downstream-eval-every": 1000,
      "downstream-eval-datasets": ["qasper:validation", "quality:boosted"],
      "downstream-eval-samples": 64,
      "downstream-eval-strides": [1, 4],
      "downstream-generate-samples": 64,
      "downstream-max-new-tokens": 32,
      "report-every": 30,
      "save-every": 5000
    }
  },

  "stage2": {
    "gpus": 2,
    "args": {
      "output-dir": "{run}/stage2",
      "init-weights-from": "{stage1_checkpoint}",
      "datasets": ["{repo}/multiagent/data/renderer_text/pg19_wikitext103_train_4k4k_20m.jsonl", "qasper+nox:train", "quality+limit=2500:train", "hotpotqa+limit=2500:train", "musique+limit=2500:train", "arc-c:train", "hellaswag+limit=3000:train", "winogrande+limit=3000:train", "mmlu+limit=3000:auxiliary_train", "{traces}"],
      "limit-per-dataset": 7500,
      "max-trace-length": 4096,
      "dense-max-length": 4096,
      "epochs": 2,
      "max-steps": 24000,
      "learning-rate": 3e-6,
      "lr-scheduler": "constant",
      "warmup-steps": 50,
      "phase-schedule": "mixed",
      "ce-batch-fraction": 1.0,
      "ce-loss": "hard",
      "dense-batch-fraction": 0.3,
      "dense-w-choices": [0, 1, 4, 16],
      "dense-datasets": ["{repo}/multiagent/data/renderer_text/pg19_train_4k4k_20m.jsonl", "{repo}/multiagent/data/renderer_text/wikitext103_train_4k4k_10m.jsonl"],
      "downstream-eval-every": 500,
      "downstream-eval-datasets": ["qasper:validation", "quality:boosted"],
      "downstream-eval-strides": [1, 4],
      "save-every": 4000,
      "empty-cache-every": 0,
      "checkpoint-receiver": true
    }
  },

  "eval": {
    "enabled": true,
    "output_dir": "{run}/eval",
    "common_args": {"seed": 42, "device": "cuda:0"},
    "vanilla": {"gpus": 1, "args": {"model": "{receiver}"}},
    "renderer": {"gpus": 1, "args": {}},
    "benchmarks": [
      {"key": "arc-c", "domain": "in-domain", "metric": "accuracy",
       "args": {"tasks": "arc-c:test", "limit-per-dataset": 500, "max-new-tokens": 64, "max-length": 2048},
       "renderer_args": {"renderer": "{stage2_checkpoint}", "renderer-decode-prefix": "generation"}},
      {"key": "hellaswag", "domain": "in-domain", "metric": "accuracy",
       "args": {"tasks": "hellaswag:validation", "limit-per-dataset": 500, "max-new-tokens": 64, "max-length": 2048},
       "renderer_args": {"renderer": "{stage2_checkpoint}", "renderer-decode-prefix": "generation"}},
      {"key": "winogrande", "domain": "in-domain", "metric": "accuracy",
       "args": {"tasks": "winogrande:validation", "limit-per-dataset": 500, "max-new-tokens": 64, "max-length": 2048},
       "renderer_args": {"renderer": "{stage2_checkpoint}", "renderer-decode-prefix": "generation"}},
      {"key": "mmlu", "domain": "in-domain", "metric": "accuracy",
       "args": {"tasks": "mmlu:test", "limit-per-dataset": 500, "max-new-tokens": 64, "max-length": 2048},
       "renderer_args": {"renderer": "{stage2_checkpoint}", "renderer-decode-prefix": "generation"}},
      {"key": "gsm8k", "domain": "in-domain", "metric": "accuracy",
       "args": {"tasks": "gsm8k:test", "limit-per-dataset": 500, "max-new-tokens": 512, "max-length": 2048},
       "renderer_args": {"renderer": "{stage2_checkpoint}", "renderer-decode-prefix": "generation"}},
      {"key": "medqa", "domain": "ood", "metric": "accuracy",
       "args": {"tasks": "medqa:test", "limit-per-dataset": 500, "max-new-tokens": 64, "max-length": 2048},
       "renderer_args": {"renderer": "{stage2_checkpoint}", "renderer-decode-prefix": "generation"}},
      {"key": "openbookqa", "domain": "ood", "metric": "accuracy",
       "args": {"tasks": "openbookqa:test", "limit-per-dataset": 500, "max-new-tokens": 64, "max-length": 2048},
       "renderer_args": {"renderer": "{stage2_checkpoint}", "renderer-decode-prefix": "generation"}},
      {"key": "math-500", "domain": "ood", "metric": "accuracy",
       "args": {"tasks": "math-500:test", "limit-per-dataset": 500, "max-new-tokens": 1024, "max-length": 2048},
       "renderer_args": {"renderer": "{stage2_checkpoint}", "renderer-decode-prefix": "generation"}},

      {"key": "quality_dev", "domain": "in-domain", "metric": "accuracy",
       "args": {"tasks": "quality:dev", "max-new-tokens": 64, "max-length": 8192},
       "renderer_args": {"renderer": "{stage2_checkpoint}/renderer.pt", "context-cache-max": 4}},
      {"key": "qasper_test100", "domain": "in-domain", "metric": "answer_f1",
       "args": {"tasks": "qasper:test", "limit-per-dataset": 100, "max-new-tokens": 64, "max-length": 8192},
       "renderer_args": {"renderer": "{stage2_checkpoint}/renderer.pt", "context-cache-max": 4}},
      {"key": "hotpotqa_val400", "domain": "in-domain", "metric": "f1",
       "args": {"limit-per-dataset": 400, "max-new-tokens": 64, "max-length": 8192},
       "vanilla_args": {"tasks": "hotpotqa+terse:validation"},
       "renderer_args": {"tasks": "hotpotqa:validation", "renderer": "{stage2_checkpoint}/renderer.pt", "context-cache-max": 4}},
      {"key": "musique_val400", "domain": "in-domain", "metric": "f1",
       "args": {"limit-per-dataset": 400, "max-new-tokens": 64, "max-length": 8192},
       "vanilla_args": {"tasks": "musique+terse:validation"},
       "renderer_args": {"tasks": "musique:validation", "renderer": "{stage2_checkpoint}/renderer.pt", "context-cache-max": 4}},
      {"key": "boolq_validation", "domain": "ood", "metric": "accuracy",
       "args": {"tasks": "boolq:validation", "max-new-tokens": 64, "max-length": 8192},
       "renderer_args": {"renderer": "{stage2_checkpoint}/renderer.pt", "context-cache-max": 4}},
      {"key": "race_test", "domain": "ood", "metric": "accuracy",
       "args": {"tasks": "race:test", "max-new-tokens": 64, "max-length": 8192},
       "renderer_args": {"renderer": "{stage2_checkpoint}/renderer.pt", "context-cache-max": 4}},
      {"key": "longhealth", "domain": "ood", "metric": "accuracy",
       "args": {"tasks": "longhealth+ppc=1:test", "max-new-tokens": 64, "max-length": 8192},
       "renderer_args": {"renderer": "{stage2_checkpoint}/renderer.pt", "context-cache-max": 4}},
      {"key": "squad_validation20pct", "domain": "ood", "metric": "f1",
       "args": {"limit-per-dataset": 2114, "max-new-tokens": 64, "max-length": 8192},
       "vanilla_args": {"tasks": "squad+terse:validation"},
       "renderer_args": {"tasks": "squad:validation", "renderer": "{stage2_checkpoint}/renderer.pt", "context-cache-max": 4}},
      {"key": "narrativeqa_test400", "domain": "ood", "metric": "f1",
       "args": {"limit-per-dataset": 400, "max-new-tokens": 64, "max-length": 8192},
       "vanilla_args": {"tasks": "narrativeqa+terse:test"},
       "renderer_args": {"tasks": "narrativeqa:test", "renderer": "{stage2_checkpoint}/renderer.pt", "context-cache-max": 4}}
    ]
  }
}
